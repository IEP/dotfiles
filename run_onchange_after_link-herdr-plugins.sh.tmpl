#!/bin/bash
# Register local herdr plugins (registration lives in herdr state, not config).
# Re-runs when a plugin manifest changes.
# open-in-vscode hash: {{ include "dot_config/herdr/local-plugins/open-in-vscode/herdr-plugin.toml" | sha256sum }}
# open-in-file-manager hash: {{ include "dot_config/herdr/local-plugins/open-in-file-manager/herdr-plugin.toml" | sha256sum }}
set -euo pipefail

command -v herdr >/dev/null || exit 0

for plugin in open-in-vscode open-in-file-manager; do
  plugin_dir="$HOME/.config/herdr/local-plugins/$plugin"
  if ! herdr plugin list 2>/dev/null | grep -q "^- local\.$plugin "; then
    herdr plugin link "$plugin_dir" >/dev/null
  fi
done
